# BauTag – Einstellungen (Kopie als deploy/.env, Rechte: chmod 600 .env)
# installieren.sh legt diese Datei automatisch an.

# Adresse der App (DNS-A-Eintrag muss auf den Server zeigen) und E-Mail für das HTTPS-Zertifikat
BAUTAG_DOMAIN=bautag.example.at
BAUTAG_EMAIL=office@example.at
BAUTAG_URL=https://bautag.example.at

# Geheimer Schlüssel (64 Hex-Zeichen) – verschlüsselt SMTP-Passwort, 2FA-Geheimnisse und Push-Schlüssel in der Datenbank.
# NICHT ändern, sonst sind diese Geheimnisse unlesbar. Auf Papier im Tresor aufbewahren.
BAUTAG_SCHLUESSEL=

# Namensliste beim Anmelden (1 = Namen wählen, 0 = nur Personalnummer)
BAUTAG_LOGIN_LISTE=1

# E-Mail-Versand (optional; kann auch in der App unter Einstellungen gesetzt werden)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Wetter (GeoSphere Austria, ohne Schlüssel); 0 = aus
BAUTAG_WETTER=1

# Alarm-E-Mail für Sicherungsfehler (wenn die App nicht erreichbar ist: Versand über sendmail des Servers)
ALARM_EMAIL=

# Externe Sicherung (restic): Zugangsdaten stehen NICHT hier, sondern in /etc/bautag/restic.env (nur root lesbar),
# damit sie nie in den App-Container gelangen. Vorlage: restic.env.beispiel
