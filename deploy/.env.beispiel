# BauTag – Einstellungen (Kopie als deploy/.env, Rechte: chmod 600 .env)
# installieren.sh legt diese Datei automatisch an.

# Adresse der App (DNS-A-Eintrag muss auf den Server zeigen) und E-Mail für das HTTPS-Zertifikat
BAUTAG_DOMAIN=bautag.example.at
BAUTAG_EMAIL=office@example.at
BAUTAG_URL=https://bautag.example.at

# Geheimer Schlüssel (64 Hex-Zeichen, mindestens 32 Zeichen – sonst startet die App nicht) – verschlüsselt SMTP-Passwort,
# KI-Schlüssel, 2FA-Geheimnisse und Push-Schlüssel in der Datenbank. NICHT ändern, sonst sind diese Geheimnisse unlesbar
# (Notfall: node server/entsperren.js <Personalnummer> --2fa bzw. --2fa-alle). Auf Papier im Tresor aufbewahren.
# BAUTAG_TEST darf hier NIE stehen (Docker setzt es ohnehin leer; mit NODE_ENV=production startet die App sonst nicht).
BAUTAG_SCHLUESSEL=

# Namensliste beim Anmelden (API.md 15.33): 0 = aus (Standard, empfohlen) – Anmeldung mit Personalnummer + PIN; am eigenen
# Handy merkt sich die App die Person, dann nur noch die PIN. 1 = öffentliche Liste aller Namen auf der Anmeldeseite (jeder,
# der die Adresse kennt, sieht alle Namen) – nur bewusst einschalten. update.sh stellt eine alte 1 einmalig auf 0 um.
BAUTAG_LOGIN_LISTE=0

# E-Mail-Versand (optional; kann auch in der App unter Einstellungen gesetzt werden)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Wetter (GeoSphere Austria, ohne Schlüssel); 0 = aus
BAUTAG_WETTER=1

# Alarm-E-Mail für Sicherungsfehler (wenn die App nicht erreichbar ist: Versand über sendmail des Servers)
ALARM_EMAIL=

# Externe Sicherung (restic): Zugangsdaten stehen NICHT hier, sondern in /etc/bautag/restic.env (nur root lesbar),
# damit sie nie in den App-Container gelangen. Vorlage: restic.env.beispiel
