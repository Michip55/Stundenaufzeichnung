# Externe, verschlüsselte Sicherung mit restic – Datei: /etc/bautag/restic.env (chmod 600, nur root)
# Zweiter Anbieter/Standort in der EU. Die Daten werden VOR dem Hochladen auf dem Server verschlüsselt.

# Variante A: Storage Box / SFTP (SSH-Schlüssel des Servers beim Anbieter hinterlegen)
#RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:/bautag

# Variante B: S3-kompatibler Speicher in der EU
#RESTIC_REPOSITORY=s3:https://s3.eu-central-2.example.com/bautag-sicherung
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Passwort des Sicherungs-Archivs (wird von installieren.sh erzeugt). OHNE DIESES PASSWORT KEINE WIEDERHERSTELLUNG.
RESTIC_PASSWORD_FILE=/etc/bautag/restic-passwort
