# Caddy holt und erneuert das HTTPS-Zertifikat (Let's Encrypt) automatisch.
# http:// wird automatisch auf https:// umgeleitet.
{
	email {$BAUTAG_EMAIL}
	# N-066: auch das Standard-Protokoll (Fehler, z. B. 502 während eines Updates → docker logs) ohne
	# Fernunterschrift-Token, Referer und Cookies. Filter wie im Zugriffsprotokoll unten.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp (?i)(/(?:fern|unterschrift)/+)[^/?#]+ $1***
				request>headers>Referer delete
				request>headers>Cookie delete
			}
		}
	}
}

{$BAUTAG_DOMAIN} {
	encode zstd gzip
	# G-09/N-032: 40 MB nur für POST auf die Upload-/Import-Pfade (App: 35 MB, Base64-JSON, nur mit Sitzung) – gleiche
	# Pfade wie dokumentPfad in app/server/index.js; alle anderen Anfragen höchstens 13 MB (größte übrige App-Grenze:
	# Fotos 12 MB). Die beiden Matcher schließen sich aus (sonst gälte die kleinere Grenze). Tabelle in ANLEITUNG.md.
	@gross {
		method POST
		path_regexp gross (?i)^/api/(baustellen/[0-9]+/(dokumente(/[0-9]+/versionen)?|lv-import)|import/bmd-op|stammdaten/[a-z]+/import)/?$
	}
	@klein {
		not {
			method POST
			path_regexp klein (?i)^/api/(baustellen/[0-9]+/(dokumente(/[0-9]+/versionen)?|lv-import)|import/bmd-op|stammdaten/[a-z]+/import)/?$
		}
	}
	request_body @gross {
		max_size 40MB
	}
	request_body @klein {
		max_size 13MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3000
	log {
		output file /data/zugriff.log {
			roll_size 10MiB
			roll_keep 10
		}
		# G-17/N-066: Fernunterschrift-Token nie im Zugriffsprotokoll (Pfad maskieren, Referer und Cookies weglassen);
		# ohne Anker und ohne Groß-/Kleinschreibung, damit auch //api/fern/…, /API/fern/… und /api/./fern/… maskiert werden
		format filter {
			wrap json
			fields {
				request>uri regexp (?i)(/(?:fern|unterschrift)/+)[^/?#]+ $1***
				request>headers>Referer delete
				request>headers>Cookie delete
			}
		}
	}
}
