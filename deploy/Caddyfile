# Caddy holt und erneuert das HTTPS-Zertifikat (Let's Encrypt) automatisch.
# http:// wird automatisch auf https:// umgeleitet.
{
	email {$BAUTAG_EMAIL}
	# N-066: auch das Standard-Protokoll (Fehler, z. B. 502 während eines Updates → docker logs) ohne
	# Fernunterschrift-Token, Referer und Cookies. Filter wie im Zugriffsprotokoll unten.
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp (?i)(/(?:fern|unterschrift)/+)[^/?#]+ $1***
				request>headers>Referer delete
				request>headers>Cookie delete
			}
		}
	}
}

{$BAUTAG_DOMAIN} {
	encode zstd gzip
	# G-09: größte App-Grenze 35 MB (Dokumente/Importe als Base64-JSON) + Reserve – Tabelle in ANLEITUNG.md
	request_body {
		max_size 40MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3000
	log {
		output file /data/zugriff.log {
			roll_size 10MiB
			roll_keep 10
		}
		# G-17/N-066: Fernunterschrift-Token nie im Zugriffsprotokoll (Pfad maskieren, Referer und Cookies weglassen);
		# ohne Anker und ohne Groß-/Kleinschreibung, damit auch //api/fern/…, /API/fern/… und /api/./fern/… maskiert werden
		format filter {
			wrap json
			fields {
				request>uri regexp (?i)(/(?:fern|unterschrift)/+)[^/?#]+ $1***
				request>headers>Referer delete
				request>headers>Cookie delete
			}
		}
	}
}
