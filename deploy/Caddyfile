# Caddy holt und erneuert das HTTPS-Zertifikat (Let's Encrypt) automatisch.
# http:// wird automatisch auf https:// umgeleitet.
{
	email {$BAUTAG_EMAIL}
}

{$BAUTAG_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 16MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3000
	log {
		output file /data/zugriff.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
