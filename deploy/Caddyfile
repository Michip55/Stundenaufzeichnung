# Caddy holt und erneuert das HTTPS-Zertifikat (Let's Encrypt) automatisch.
# http:// wird automatisch auf https:// umgeleitet.
{
	email {$BAUTAG_EMAIL}
}

{$BAUTAG_DOMAIN} {
	encode zstd gzip
	# G-09: größte App-Grenze 35 MB (Dokumente/Importe als Base64-JSON) + Reserve – Tabelle in ANLEITUNG.md
	request_body {
		max_size 40MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3000
	log {
		output file /data/zugriff.log {
			roll_size 10MiB
			roll_keep 10
		}
		# G-17: Fernunterschrift-Token nie im Zugriffsprotokoll (Pfad maskieren, Referer und Cookies weglassen)
		format filter {
			wrap json
			fields {
				request>uri regexp ^(/api/fern/|/unterschrift/)[^/?#]+ $1***
				request>headers>Referer delete
				request>headers>Cookie delete
			}
		}
	}
}
